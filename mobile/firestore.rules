rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só acessa o próprio documento.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == 'PENDING_VERIFICATION'
                    && request.resource.data.papel in ['CLIENTE', 'PRESTADOR'];

      // Papel não muda; o status só vira ACTIVE com o e-mail realmente verificado.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.papel == resource.data.papel
                    && (request.resource.data.status == resource.data.status
                        || (request.resource.data.status == 'ACTIVE' && request.auth.token.email_verified == true));
    }
  }
}
