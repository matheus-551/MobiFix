{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
       "android": {
     "adaptiveIcon": {
       "foregroundImage": "./assets/logo.png",
       "backgroundColor": "#1C2430"
     },
     "predictiveBackGestureEnabled": false
   },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
