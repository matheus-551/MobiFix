NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL da API Spring Boot (usada pelo rewrite do Next.js para /api/v1/*). Padrão: http://localhost:8080
API_URL=http://localhost:8080

# A autenticação (cadastro, verificação de e-mail, login e redefinição de senha) é 100% Firebase Authentication:
# o front só precisa das variáveis NEXT_PUBLIC_FIREBASE_* acima. Nenhuma credencial de administrador fica aqui;
# a conta de serviço (Firebase Admin SDK) pertence ao backend Spring Boot, que valida os ID Tokens.
