NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL da API Spring Boot (usada pelo rewrite do Next.js para /api/v1/*). Padrão: http://localhost:8080
API_URL=http://localhost:8080

# (Opcional) Base das chamadas HTTP feitas pelo navegador. Padrão: /api/v1 (mesma origem, via rewrite do Next.js,
# o que evita CORS). Só defina se quiser chamar a API diretamente; nesse caso inclua a origem do site em
# CORS_ALLOWED_ORIGINS no backend. Ex.: http://localhost:8080/api/v1
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Verificação de e-mail no cadastro/login: true (padrão) exige confirmar o e-mail; false dispensa a etapa.
# Ao mudar, reinicie o `npm run dev` (ou refaça o build) e rode `npm run rules:email` para alinhar as regras do
# Firestore, depois publique-as (`firebase deploy --only firestore:rules`). Detalhes em src/shared/config/features.ts.
NEXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=true

# Proteção de navegação das rotas privadas (/cliente/**, /prestador/**): true (padrão) = ativada.
# false = desativa SOMENTE em desenvolvimento (`npm run dev`), para testes; em produção é sempre ativada.
# NÃO libera a API: as rotas protegidas do backend continuam exigindo o ID token do Firebase.
# Chave central e explicação: src/features/auth/config/routeProtection.ts. Reinicie o `npm run dev` ao mudar.
NEXT_PUBLIC_ROUTE_PROTECTION_ENABLED=true

# A autenticação (cadastro, verificação de e-mail, login e redefinição de senha) é 100% Firebase Authentication:
# o front só precisa das variáveis NEXT_PUBLIC_FIREBASE_* acima. Nenhuma credencial de administrador fica aqui;
# a conta de serviço (Firebase Admin SDK) pertence ao backend Spring Boot, que valida os ID Tokens.
