rules_version = '2';

// Coleções: users/{uid}, clientProfiles/{uid}, providerProfiles/{uid}, appointments/{id}, reviews/{appointmentId}.
// Papel (role), status e aprovação NUNCA podem ser alterados pelo próprio usuário.
// O papel "admin" só pode ser atribuído manualmente no console / Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Papel do usuário depois que a escrita (batch) for aplicada.
    function roleAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Autocadastro: somente cliente (ativo) ou prestador (pendente de análise).
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.role in ['client', 'provider']
        && request.resource.data.status == (request.resource.data.role == 'client' ? 'active' : 'pending')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Mudanças de papel/status exigem operação privilegiada (console ou Admin SDK).
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /clientProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && roleAfter(uid) == 'client'
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'phone', 'state', 'createdAt', 'updatedAt'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() in range(1, 61)
        && request.resource.data.lastName is string && request.resource.data.lastName.size() in range(1, 61)
        && request.resource.data.phone is string && request.resource.data.phone.size() in range(10, 20)
        && request.resource.data.state is string && request.resource.data.state.size() == 2
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && onlyChanges(['firstName', 'lastName', 'phone', 'state', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /providerProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && roleAfter(uid) == 'provider'
        && request.resource.data.keys().hasOnly([
          'responsibleName', 'displayName', 'phone', 'taxIdType', 'taxId', 'address', 'city', 'state',
          'vehicleTypeIds', 'specialtyIds', 'documents', 'approvalStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.approvalStatus == 'under_review'
        && request.resource.data.responsibleName is string && request.resource.data.responsibleName.size() in range(2, 61)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() in range(2, 61)
        && request.resource.data.phone is string && request.resource.data.phone.size() in range(10, 20)
        && request.resource.data.taxIdType in ['cpf', 'cnpj']
        && request.resource.data.taxId is string && request.resource.data.taxId.size() in [11, 14]
        && request.resource.data.address is string && request.resource.data.address.size() in range(5, 200)
        && request.resource.data.city is string && request.resource.data.city.size() > 0
        && request.resource.data.state is string && request.resource.data.state.size() == 2
        && request.resource.data.vehicleTypeIds is list && request.resource.data.vehicleTypeIds.size() in range(1, 11)
        && request.resource.data.specialtyIds is list && request.resource.data.specialtyIds.size() in range(1, 21)
        && request.resource.data.documents is list && request.resource.data.documents.size() in range(1, 3)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // O prestador edita só dados de contato/atuação; documentos, CPF/CNPJ e aprovação são administrativos.
      allow update: if isOwner(uid)
        && onlyChanges(['displayName', 'phone', 'address', 'city', 'state', 'vehicleTypeIds', 'specialtyIds', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Agendamentos do cliente. ID = {uid}_{slotId} (impede duplicidade). O cliente só cria como "requested"
    // e só pode cancelar; "confirmed"/"completed" são definidos por admin (ou, no futuro, pelo prestador/API).
    match /appointments/{appointmentId} {
      // resource == null permite o getDoc de verificação de duplicidade em documento ainda inexistente.
      allow read: if signedIn() && (resource == null || resource.data.clientId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && appointmentId == request.auth.uid + '_' + request.resource.data.slotId
        && request.resource.data.keys().hasOnly([
          'clientId', 'providerId', 'providerName', 'vehicleId', 'vehicleLabel', 'specialtyIds',
          'specialtyNames', 'slotId', 'date', 'time', 'description', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'requested'
        && request.resource.data.providerId is string && request.resource.data.providerId.size() > 0
        && request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0
        && request.resource.data.slotId is string && request.resource.data.slotId.size() > 0
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.time is string && request.resource.data.time.size() == 5
        && request.resource.data.specialtyIds is list && request.resource.data.specialtyIds.size() in range(1, 21)
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.status in ['requested', 'confirmed']
        && onlyChanges(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Avaliações são públicas para usuários autenticados (aparecem no perfil do prestador).
    // Uma por atendimento concluído: ID = ID do agendamento; sem edição ou exclusão.
    match /reviews/{appointmentId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.appointmentId == appointmentId
        && exists(/databases/$(database)/documents/appointments/$(appointmentId))
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.status == 'completed'
        && request.resource.data.providerId == get(/databases/$(database)/documents/appointments/$(appointmentId)).data.providerId
        && request.resource.data.keys().hasOnly(['appointmentId', 'providerId', 'clientId', 'clientName', 'rating', 'comment', 'createdAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && request.resource.data.clientName is string && request.resource.data.clientName.size() in range(1, 101)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
